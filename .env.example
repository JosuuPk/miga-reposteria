# Configuración de ejemplo. Copia este archivo como ".env" y rellena los valores.
# El archivo ".env" no se sube a Git. En el alojamiento, estas variables se
# escriben en su panel (Environment variables) y luego se vuelve a publicar.
#
# Nada de esto es secreto: el número de WhatsApp y la dirección del sitio quedan
# visibles para cualquier visitante. No pongas aquí contraseñas ni claves.

# Número de WhatsApp del negocio en formato internacional, solo dígitos
# (código de país + número, sin "+", espacios ni guiones).
# Vacío = modo demostración: la web permite revisar y copiar la solicitud,
# pero no abre WhatsApp.
VITE_WHATSAPP_NUMBER=

# Dirección pública del sitio, sin barra final. Se usa para la vista previa al
# compartir el enlace. Vacío = no se añade imagen de vista previa.
# Ejemplo de formato: https://tu-dominio.com
VITE_SITE_URL=
